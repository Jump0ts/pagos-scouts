# Copia este fichero a backend/.env para desarrollo local. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/pagos_scouts_dev"

# Direccion de la web: los enlaces de invitacion y de restablecer contrasena apuntan aqui.
PUBLIC_URL=http://localhost:5173

# Base de datos SOLO para los tests (su nombre debe contener "test") (se borra y se rehace en cada ejecucion cuando haya modelos).
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/pagos_scouts_test"
