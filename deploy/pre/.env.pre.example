# Copia este fichero a deploy/pre/.env.pre EN EL SERVIDOR y rellena los valores. Nunca lo subas al repositorio.
# Genera la contrasena en el propio servidor, por ejemplo con:  openssl rand -hex 24

POSTGRES_USER=pagos_scouts
POSTGRES_PASSWORD=GENERAR_EN_EL_SERVIDOR
POSTGRES_DB=pagos_scouts_pre

# Direccion publica de pre: los enlaces de invitacion y de restablecer contrasena apuntan aqui.
PUBLIC_URL=https://pre-scouts.josanfersal.dev

# Puerto local (solo 127.0.0.1) por el que el nginx del servidor llega a la web. Elige uno libre.
WEB_PORT=8090
